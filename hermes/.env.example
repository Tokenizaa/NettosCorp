# HERMES — Variáveis de ambiente de exemplo da NettosCorp
#
# Copie este arquivo para ~/.hermes/.env e preencha com suas credenciais.
# NUNCA commite ~/.hermes/.env com chaves reais. Este arquivo é um exemplo.
#
# Mais informações: https://hermes-agent.nousresearch.com/docs/user-guide/secrets/

# ── LLM Provider (NVIDIA NIM — padrão da NettosCorp) ─────────────────────────
# Obtenha sua chave em: https://build.nvidia.com/
# NVIDIA_API_KEY=sua_chave_aqui

# ── Fallback: OpenRouter ─────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sua_chave_aqui

# ── Outros providers (descomente os que usar) ────────────────────────────────
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GLM_API_KEY=
# KIMI_API_KEY=
# MINIMAX_API_KEY=
# HF_TOKEN=
# NOUS_API_KEY=

# ── Voice (TTS Piper — português brasileiro) ─────────────────────────────────
# HERMES_TTS_PROVIDER=piper
# HERMES_TTS_PIPER_VOICE=$HOME/.hermes/voices/pt_BR-faber-medium.onnx

# ── STT (faster-whisper) ─────────────────────────────────────────────────────
# HERMES_STT_PROVIDER=faster-whisper

# ── Banco / Paperclip (opcional) ─────────────────────────────────────────────
# DATABASE_URL=postgresql://...
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Shell hooks / segredos externos ──────────────────────────────────────────
# BWS_ACCESS_TOKEN=
# OP_SERVICE_ACCOUNT_TOKEN=
# HONCHO_API_KEY=
