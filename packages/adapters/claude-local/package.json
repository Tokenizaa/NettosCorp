  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@paperclip/shared": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  }
}