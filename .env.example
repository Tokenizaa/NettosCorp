# Paperclip Environment Configuration
# Copy to .env and fill in your values

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
ANTHROPIC_WORKSPACE_ID=wrkspc_xxxxxxxxxxxxx

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxx

# Google (Gemini)
GOOGLE_API_KEY=xxxxxxxxxxxxx

# Cohere
COHERE_API_KEY=xxxxxxxxxxxxx

# NVIDIA NIM
NVIDIA_API_KEY=xxxxxxxxxxxxx

# Optional: Custom base URLs for proxies (e.g., free-claude-code)
# ANTHROPIC_BASE_URL=http://127.0.0.1:8082/v1
# OPENAI_BASE_URL=http://127.0.0.1:8082/v1
# GOOGLE_BASE_URL=http://127.0.0.1:8082/v1