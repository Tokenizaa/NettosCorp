{
  "name": "Paperclip Operations",
  "role": "engineer",
  "title": "Paperclip Operations Agent",
  "icon": "cpu",
  "capabilities": "Manages Paperclip platform operations: issue lifecycle, task creation/delegation, PR approvals, run monitoring, agent hiring, control-plane operations via API and MCP",
  "reportsTo": null,
  "adapterType": "claude_local",
  "runner": "auto",
  "adapterConfig": {
    "engine": "acp",
    "model": "claude-opus-5-5",
    "effort": "high",
    "cwd": "/workspace",
    "instructionsFilePath": "/workspace/AGENTS.md",
    "dangerouslySkipPermissions": true,
    "maxTurnsPerRun": 50,
    "timeoutSec": 600,
    "graceSec": 30,
    "env": {
      "PAPERCLIP_API_URL": "{{PAPERCLIP_API_URL}}",
      "PAPERCLIP_API_KEY": "{{PAPERCLIP_API_KEY}}",
      "PAPERCLIP_COMPANY_ID": "{{PAPERCLIP_COMPANY_ID}}",
      "PAPERCLIP_AGENT_ID": "{{PAPERCLIP_AGENT_ID}}",
      "PAPERCLIP_RUN_ID": "{{PAPERCLIP_RUN_ID}}"
    }
  },
  "runtimeConfig": {
    "heartbeat": {
      "enabled": true,
      "intervalSec": 300,
      "wakeOnDemand": true
    },
    "maxConcurrentRuns": 5
  },
  "desiredSkills": [
    "paperclip",
    "paperclip-create-agent"
  ],
  "permissions": {
    "canCreateAgents": true,
    "canCreateSkills": false,
    "canAssignTasks": true,
    "trustPreset": "standard",
    "authorizationPolicy": {
      "trustPreset": "standard"
    }
  },
  "budgetMonthlyCents": 50000,
  "metadata": {
    "description": "Paperclip Operations Agent - manages issues, tasks, PRs, runs, hiring via API/MCP",
    "createdBy": "company-creator skill",
    "version": "1.0"
  }
}